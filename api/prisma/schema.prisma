// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  key       String   @unique
  createdAt DateTime @default(now())
}

model Employee {
  id        Int        @id @default(autoincrement())
  number    String        @unique
  name      String
  photoUrl  String?
  pension     String?
  dependencia String?
  email       String?
  telefono    String?
  tipo        String?
  cards     Card[]
  accesses  AccessLog[]
  replacedAs      Replacement[] @relation("OriginalEmployee")
  replacementFor  Replacement[] @relation("ReplacementEmployee")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Card {
  uid         String   @id
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  linkedAt    DateTime @default(now())
}

model AccessLog {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   Employee  @relation(fields: [employeeId], references: [id])
  kioskId    String
  method     AccessMethod
  timestamp  DateTime  @default(now())
}

enum AccessMethod {
  RFID
  MANUAL
}

model Replacement {
  id                     Int      @id @default(autoincrement())
  originalEmployeeId     Int
  originalEmployee       Employee @relation("OriginalEmployee", fields: [originalEmployeeId], references: [id])
  replacementEmployeeId  Int
  replacementEmployee    Employee @relation("ReplacementEmployee", fields: [replacementEmployeeId], references: [id])
  kioskId                String?
  createdAt              DateTime @default(now())
}